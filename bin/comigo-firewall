#!/usr/bin/env bash
# 只管理带插件标记的局域网 TCP 放行规则，授权仅用于调用 UFW。
set -euo pipefail
ufw_config=/etc/ufw/ufw.conf
ufw_rules=/etc/ufw/user.rules
marker=6f6d61726368792d636f6d69676f
fail() { printf '{"error":"%s"}\n' "$1"; exit 1; }
private_cidr() {
  local a b c d prefix
  [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})/([0-9]{1,2})$ ]] || return 1
  a=$((10#${BASH_REMATCH[1]}));b=$((10#${BASH_REMATCH[2]}));c=$((10#${BASH_REMATCH[3]}));d=$((10#${BASH_REMATCH[4]}));prefix=$((10#${BASH_REMATCH[5]}))
  ((a<=255 && b<=255 && c<=255 && d<=255 && prefix<=32)) || return 1
  (( (a==10 && prefix>=8) || (a==172 && b>=16 && b<=31 && prefix>=12) || (a==192 && b==168 && prefix>=16) ))
}
valid_iface() { [[ "$1" =~ ^[a-zA-Z0-9_.:-]+$ ]]; }
action="${1:-status}"; endpoint="${2:-}"
[[ "$endpoint" =~ ^https?://(127\.0\.0\.1|localhost|\[::1\])(:([0-9]+))?(/[^\?#]*)?$ ]] || fail local_url_required
port="${BASH_REMATCH[3]:-}"
[[ -n "$port" ]] || { port=80; [[ "$endpoint" != https:* ]] || port=443; }
[[ "$port" =~ ^[0-9]{1,5}$ ]] || fail invalid_port
port=$((10#$port)); ((port>=1 && port<=65535)) || fail invalid_port
supported=false enabled=false readable=false configured=false iface="" subnet=""
command -v ufw >/dev/null && command -v ip >/dev/null && supported=true
if [[ -r "$ufw_config" ]]; then
  while IFS= read -r line; do [[ "$line" != ENABLED=yes ]] || enabled=true; done < "$ufw_config"
fi
if [[ "$supported" == true ]]; then
  # 默认路由所在网卡的直连私网，不放行公网、VPN 或其他网卡。
  while read -ra route; do
    for ((i=0;i<${#route[@]}-1;i++)); do
      if [[ "${route[i]}" == dev ]]; then iface="${route[i+1]}";break;fi
    done
    [[ -z "$iface" ]] || break
  done < <(ip -4 route show default)
  case "$iface" in lo|tailscale*|tun*|wg*|docker*|br-*) iface="";; esac
  if ! valid_iface "$iface"; then iface=""; fi
  if [[ -n "$iface" ]]; then
    while read -ra route; do
      if private_cidr "${route[0]:-}"; then subnet="${route[0]}";break;fi
    done < <(ip -4 route show dev "$iface" scope link)
  fi
fi
owned_ports=() owned_subnets=() owned_ifaces=()
if [[ -r "$ufw_rules" ]]; then
  readable=true
  while IFS= read -r line; do
    [[ "$line" == '### tuple ### allow tcp '* ]] || continue
    read -ra fields <<< "$line"
    [[ ${#fields[@]} -ge 10 && "${fields[6]}" == 0.0.0.0/0 && "${fields[7]}" == any && "${fields[9]}" == in_* ]] || continue
    rule_port="${fields[5]}"; rule_subnet="${fields[8]}"; rule_iface="${fields[9]#in_}"
    if [[ "$rule_port" == "$port" && "$rule_subnet" == "$subnet" && "$rule_iface" == "$iface" ]]; then configured=true; fi
    [[ "${fields[10]:-}" == "comment=$marker" && "$rule_port" =~ ^[0-9]{1,5}$ ]] || continue
    ((10#$rule_port>=1 && 10#$rule_port<=65535)) || continue
    private_cidr "$rule_subnet" && valid_iface "$rule_iface" || continue
    owned_ports+=("$rule_port");owned_subnets+=("$rule_subnet");owned_ifaces+=("$rule_iface")
  done < "$ufw_rules"
fi
case "$action" in
 status)
  printf '{"supported":%s,"enabled":%s,"readable":%s,"configured":%s,"port":%s,"interface":"%s","subnet":"%s","ownedCount":%s}\n' "$supported" "$enabled" "$readable" "$configured" "$port" "$iface" "$subnet" "${#owned_ports[@]}"
  ;;
 open)
  [[ "$supported" == true && "$readable" == true ]] || fail firewall_unavailable
  [[ "$enabled" == true ]] || fail firewall_disabled
  [[ -n "$iface" && -n "$subnet" ]] || fail lan_not_found
  # 已有等价规则属于用户，保持原样，撤销时只匹配插件标记。
  if [[ "$configured" != true ]]; then
    pkexec /usr/bin/ufw allow in on "$iface" proto tcp from "$subnet" to any port "$port" comment omarchy-comigo >&2 || fail firewall_failed
  fi
  printf '{"ok":true}\n'
  ;;
 close)
  [[ "$supported" == true && "$readable" == true ]] || fail firewall_unavailable
  for ((i=0;i<${#owned_ports[@]};i++)); do
    pkexec /usr/bin/ufw --force delete allow in on "${owned_ifaces[i]}" proto tcp from "${owned_subnets[i]}" to any port "${owned_ports[i]}" comment omarchy-comigo >&2 || fail firewall_failed
  done
  printf '{"ok":true}\n'
  ;;
 *) fail unknown_action;;
esac
