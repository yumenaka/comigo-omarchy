#!/usr/bin/env bash
# QML 解析 JSON；Bash 直接管理本插件启动的 Comigo 进程。
set -euo pipefail
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-comigo"
run_dir="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}/omarchy-comigo-$UID}/omarchy-comigo"
pid_file="$run_dir/process"

json_string() {
  local value="$1"
  value=${value//\\/\\\\}; value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}; value=${value//$'\r'/\\r}; value=${value//$'\t'/\\t}
  printf '"%s"' "$value"
}
fail() { printf '{"error":"%s"}\n' "$1"; exit 1; }
find_cli() {
  binary="" version="" desktop=false
  local candidate output help wanted="${1:-}"
  if [[ "$wanted" == '~/'* ]]; then wanted="$HOME/${wanted:2}"; fi
  local candidates=(comi comigo)
  [[ -z "$wanted" ]] || candidates=("$wanted")
  for candidate in "${candidates[@]}"; do
    candidate=$(command -v -- "$candidate") || continue
    [[ -f "$candidate" && -x "$candidate" ]] || continue
    output=$("$candidate" --version 2>/dev/null) || continue
    if [[ "$output" =~ Comigo[[:space:]]+([^[:space:]]+) ]]; then
      binary="$candidate"; version="${BASH_REMATCH[1]}"
      help=$("$binary" --help 2>/dev/null) || help=""
      if [[ "$help" == *"Machine-readable desktop integration:"* ]]; then desktop=true; fi
      return
    fi
  done
}
# PID 与内核启动时间同时匹配，避免 PID 复用后误杀其他进程。
process_stamp() {
  local line rest
  [[ "$1" =~ ^[0-9]+$ && -r "/proc/$1/stat" ]] || return 1
  IFS= read -r line < "/proc/$1/stat" || return 1
  rest="${line##*) }"; read -ra fields <<< "$rest"
  [[ "${fields[0]}" != Z ]] || return 1
  printf '%s' "${fields[19]}"
}
owned_process() {
  pid="" stamp=""
  [[ -f "$pid_file" && ! -L "$pid_file" ]] || return 1
  read -r pid stamp < "$pid_file" || return 1
  [[ -n "$stamp" && "$(process_stamp "$pid" || true)" == "$stamp" ]]
}
stop_process() {
  owned_process || return 0
  kill -TERM "$pid" || fail service_error
  for ((attempt=0;attempt<30;attempt++)); do
    if ! owned_process; then rm -f -- "$pid_file"; return; fi
    sleep 1
  done
  fail stop_timeout
}
local_endpoint() {
  # 启停只管理本机；REST 阅读可以使用用户明确设置的其他地址。
  [[ "$1" =~ ^https?://(127\.0\.0\.1|localhost|\[::1\])(:([0-9]+))?(/[^\?#]*)?$ ]] || fail local_url_required
  host="${BASH_REMATCH[1]}"; host=${host//[\[\]]/}
  port="${BASH_REMATCH[3]:-}"
  [[ -n "$port" ]] || { port=80; [[ "$1" != https:* ]] || port=443; }
}

firewall_runner="${BASH_SOURCE[0]%/*}/comigo-firewall"
action="${1:-status}"; shift || true
case "$action" in
  firewall-open|firewall-close) exec bash "$firewall_runner" "${action#firewall-}" "${1:?URL}";;
  request)
    method="${1:?method}" base="${2:?URL}" path="${3:?path}"
    [[ "$base" == http://* || "$base" == https://* ]] || fail invalid_url
    [[ "$path" == /api/* || "$path" == /healthz ]] || fail invalid_url
    token="" body=""
    IFS= read -r token || true
    IFS= read -r -d '' body || true
    # 凭据通过 stdin/文件描述符交给 curl，不进入进程参数或磁盘。
    [[ "$token" != *[!A-Za-z0-9._~-]* ]] || fail invalid_token
    headers='header = "Content-Type: application/json"'
    [[ -z "$token" ]] || headers+=$'\n''header = "Authorization: Bearer '"$token"'"'
    args=(-q --silent --show-error --connect-timeout 3 --max-time 15 --noproxy localhost,127.0.0.1,::1 --request "$method" --config - --write-out $'\n%{http_code}')
    [[ "$method" == GET ]] || args+=(--data-binary @/dev/fd/3)
    curl "${args[@]}" --url "${base%/}$path" 3< <(printf '%s' "$body") <<< "$headers"
    ;;
  status)
    find_cli "${1:-}"
    installed=false active=inactive
    [[ -z "$binary" ]] || installed=true
    if owned_process; then active=active; fi
    printf '{"installed":%s,"desktop":%s,"cliPath":' "$installed" "$desktop"
    json_string "$binary"; printf ',"version":'; json_string "$version"; printf ',"active":'; json_string "$active"
    printf ',"logPath":'; json_string "$state_dir/comi.log"
    firewall=$(bash "$firewall_runner" status "${2:-http://127.0.0.1:1234/}" 2>/dev/null) || firewall='{"supported":false}'
    printf ',"firewall":%s}\n' "$firewall"
    ;;
  start|stop|restart|autostart)
    local_endpoint "${1:?URL}"
    umask 077
    mkdir -p -- "$run_dir" "$state_dir"
    # 短期锁防止多个面板或手动调用同时启停；锁不包含常驻进程。
    mkdir "$run_dir/lock" 2>/dev/null || fail busy
    trap 'rmdir "$run_dir/lock"' EXIT
    # 运行目录在退出登录/重启后清空；重载插件不能重置重试预算或撤销手动停止。
    if [[ "$action" == autostart ]]; then
      [[ ! -f "$run_dir/autostart-done" ]] || { printf '{"ok":true}\n'; exit 0; }
      count=0
      if [[ -f "$run_dir/autostart-attempts" ]]; then read -r count < "$run_dir/autostart-attempts" || true; fi
      [[ "$count" =~ ^[0-3]$ ]] || count=3
      (( count < 3 )) || fail autostart_exhausted
      printf '%s\n' "$((count+1))" > "$run_dir/autostart-attempts"
    else
      touch "$run_dir/autostart-done"
    fi
    if [[ "$action" == stop || "$action" == restart ]]; then stop_process; fi
    if [[ "$action" == stop ]]; then printf '{"ok":true}\n'; exit 0; fi
    if owned_process; then touch "$run_dir/autostart-done"; printf '{"ok":true}\n'; exit 0; fi
    find_cli "${2:-}"; [[ -n "$binary" ]] || fail missing_cli
    library="${3:-}"
    library="${library/#\~/$HOME}"
    # 留空时不传书库参数，由 Comigo 自行决定默认书库。
    args=(--no-tui --open-browser=false)
    if [[ -n "$library" ]]; then
      [[ -d "$library" ]] || fail library_required
      library=$(realpath -- "$library")
      args+=("$library")
    fi
    binary=$(realpath -- "$binary")
    if (exec 3<>"/dev/tcp/$host/$port") 2>/dev/null; then fail port_conflict; fi
    # nohup 使 CLI 不随面板热重载退出；仅保存 PID/启动时间，日志不含登录请求。
    (if [[ -n "$library" ]]; then cd -- "$library"; fi; exec nohup "$binary" "${args[@]}") </dev/null >>"$state_dir/comi.log" 2>&1 &
    pid=$!; stamp=$(process_stamp "$pid") || fail service_error
    printf '%s %s\n' "$pid" "$stamp" > "$pid_file"
    for ((attempt=0;attempt<30;attempt++)); do
      owned_process || fail service_error
      if curl -q --noproxy '*' --silent --fail --connect-timeout 1 --max-time 1 "${1%/}/healthz" >/dev/null; then
        touch "$run_dir/autostart-done"
        printf '{"ok":true}\n'; exit 0
      fi
      sleep 1
    done
    stop_process
    fail start_timeout
    ;;
  save-settings)
    # 文件仅含非敏感界面设置，JSON 由 QML 生成，禁止 source/eval 配置。
    directory="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-comigo"
    mkdir -p -- "$directory"
    temporary=$(mktemp "$directory/settings.XXXXXX")
    trap 'rm -f -- "$temporary"' EXIT
    content=""; IFS= read -r -d '' content || true
    printf '%s\n' "$content" > "$temporary"
    mv -- "$temporary" "$directory/settings.json"
    printf '{"ok":true}\n'
    ;;
  *) fail unknown_action ;;
esac
